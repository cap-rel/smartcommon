{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "storybook-static"],
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-unsafe-optional-chaining": "error",
    "array-callback-return": ["error", { "allowImplicit": true }],
    "no-prototype-builtins": "error",

    "no-unused-vars": "off",
    "react-hooks/exhaustive-deps": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{js,jsx}", "**/*.spec.{js,jsx}"],
      "env": {
        "browser": true,
        "node": true,
        "es2024": true
      }
    },
    {
      "files": ["src/lib/**/*.{js,jsx}"],
      "rules": { "no-console": "error" }
    },
    {
      "files": [
        "src/lib/**/*.test.{js,jsx}",
        "src/lib/**/stories/**",
        "src/lib/**/pages/**",
        "src/lib/sw/**",
        "src/lib/utils/functions/consoleLogs.js",
        "src/lib/components/others/DebugWarnings/**",
        "src/lib/components/others/DebugConsole/**",
        "src/lib/hooks/useApiTest/**",
        "src/lib/hooks/useApiTest2/**"
      ],
      "rules": { "no-console": "off" }
    }
  ]
}
